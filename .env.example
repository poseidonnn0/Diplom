# Скопируйте файл в .env и поправьте значения. Все параметры необязательны.

# База данных. По умолчанию SQLite в data/occupancy.db.
# OCC_DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/occupancy

# Источник подсчётов: off (ничего не собирать), demo (имитация), video (камера или файл).
OCC_SOURCE=demo

# Для режима video: путь к файлу, номер USB-камеры (0, 1, ...) или адрес RTSP/HLS-потока.
OCC_VIDEO_URL=data/samples/test_video.mp4
OCC_WEIGHTS=yolov8n.pt
OCC_CONFIDENCE=0.5

# Пароль администратора. Если не задан, при запуске печатается случайный.
# OCC_ADMIN_PASSWORD=change-me

OCC_TIMEZONE=Europe/Kaliningrad
